// Pin constraints for frame_capture (Phase 2 whole-frame capture).
//
// ============================================================================
// THE CONSTRAINT THAT DETERMINES EVERY PROBE PIN BELOW
// ============================================================================
// Phase 3 drives a panel from the board's own 40-pin RGB LCD FPC connector, and
// Phase 4 does that WHILE capturing -- so those pins cannot be shared with the
// probes by time-multiplexing. Per the DISPLAY sheet of
// docs/Tang_Nano_20K_3923_Schematics-1.pdf, that connector permanently reserves
// twenty FPGA pins:
//
//   25 HS   26 VS   27..31 B7..B3   32..37 G7..G2   38..42 R7..R3
//   48 DE   77 CK              (+ 49 backlight, + 15..18 LCD_INT0..3 = the LEDs)
//
// The first version of this file predated that analysis and put nine probes
// straight onto LCD pins (77, 25, 26, 48, 27, 28, 29, 30, 31). It would have
// worked perfectly for Phase 1 and made Phase 3 impossible -- discovered only
// after probe wires were soldered to a calculator.
//
// Subtracting the LCD connector, the BL616 pins (13/69/70/75/76/86) and the six
// LED pins leaves exactly THIRTEEN usable header pins for twelve probes. There
// is one spare (pin 52). Every probe pin below therefore carries some caveat;
// they are documented rather than hidden, and the ranking behind each choice is
// in boards/tangnano20k/pinout.md.
//
// Bank voltage: the Gowin report lists banks 0/4/5 as LVCMOS18 with BankVccio
// 1.8, which is the tool's default for a bank holding no assigned I/O -- NOT the
// board. The POWER sheet shows VCCO_4 and VCCO_5 fed by ME6211C33 (3.3 V LDOs)
// and the datasheet pinout legend marks every bank V_IO = 3.3 V.
//
// Every pin was also checked against the Function column of the Gowin pin
// report, because this repo has paid three times for not doing that: pin 88 is
// MODE0, pin 87 is MODE1, and pin 4 is LPLL1_T_in rather than a GCLK_PIN.

IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Onboard BL616 UART. Unchanged from proto-phase-1: verified working at
// 1 Mbaud, hard-wired to the BL616 with no jumper, so never drive externally.
IO_LOC "uart_rx" 70;
IO_PORT "uart_rx" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8;

// ---------------------------------------------------------------- probes
//
// Mapped to the HP Prime's 45-pin LCD flex, pins 7-18, identified by
// oscilloscope in docs/"HP Prime LCD Pinout.xlsx":
//   flex 7  DE      9.8 kHz bursts, 24.7 ms on / 1.96 ms off (= 237 active lines)
//   flex 8  VSYNC   37.7 Hz
//   flex 9  HSYNC   9.61 kHz          -> 255 lines/frame, 320x240 panel
//   flex 10 DOTCLK  13.1 MHz          -> 1363 DOTCLKs per line
//   flex 11..18     D0..D7
//
// PULL_MODE=DOWN so an UNCONNECTED channel reads a steady 0 rather than
// floating. A floating logic-analyser input produces convincing-looking noise,
// which is the worst possible failure mode for a tool whose whole job is
// telling you what a wire did. It also holds pin 51 (the audio amp's SD_MODE)
// shut down while nothing is attached.

IO_LOC "probe[0]" 80;    // DOTCLK <- flex 10.
IO_PORT "probe[0]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
// GCLKT_0 -- the fastest signal on the only global-clock-capable pin still
// available. Nothing in this design clocks off it today; a future synchronous
// capture mode (sample ON DOTCLK rather than oversampling, which is how a full
// frame fits in memory) needs exactly that, and pin assignments are the
// expensive thing to change once wires are soldered to a calculator.
// Shares the microSD DAT2 net: a 10k pull-up, negligible, but do not expect
// this to work with an SD card inserted.

IO_LOC "probe[1]" 71;    // HSYNC  <- flex 9   (clean: header only)
IO_PORT "probe[1]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC "probe[2]" 53;    // VSYNC  <- flex 8
IO_PORT "probe[2]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
// The ONE pin carrying a 2.2k pull-up to 3V3 (HDMI DDC, through a 2N7002).
// That makes the Prime's driver sink an extra ~1.5 mA when low, and if its V_OL
// rises past the FPGA's 0.8 V V_IL the channel misreads. Deliberately assigned
// to the 37.7 Hz frame sync: a corrupted VSYNC is instantly obvious in the
// decode, whereas a corrupted data bit is silent and yields plausible-looking
// wrong pixels.

IO_LOC "probe[3]" 51;    // DE     <- flex 7
IO_PORT "probe[3]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;
// Doubles as the audio amp's SD_MODE and as RPLL2_T_in. Both are acceptable:
// this design uses the LEFT PLL, and with no speaker fitted on J4 the amp is
// inert (PULL_MODE=DOWN holds it shut down when nothing is connected).
// Preferred over the spare pin 52, which carries the second 2.2k DDC pull-up.

IO_LOC "probe[4]" 72;    // D0     <- flex 11  (clean: header only)
IO_PORT "probe[4]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC "probe[5]" 73;    // D1     <- flex 12  (clean: header only)
IO_PORT "probe[5]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC "probe[6]" 74;    // D2     <- flex 13  (clean: header only)
IO_PORT "probe[6]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC "probe[7]" 85;    // D3     <- flex 14  (microSD DAT1, 10k pull-up)
IO_PORT "probe[7]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC "probe[8]" 79;    // D4     <- flex 15  (WS2812 data-in via 100R; GCLKC_0)
IO_PORT "probe[8]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC "probe[9]" 56;    // D5     <- flex 16  (I2S_BCLK -> amp input, high-Z)
IO_PORT "probe[9]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC "probe[10]" 54;   // D6     <- flex 17  (I2S_DIN  -> amp input, high-Z)
IO_PORT "probe[10]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

IO_LOC "probe[11]" 55;   // D7     <- flex 18  (I2S_LRCK -> amp input, high-Z)
IO_PORT "probe[11]" IO_TYPE=LVCMOS33 PULL_MODE=DOWN;

// ------------------------------------------------------------------ LEDs
IO_LOC "leds[0]" 15;
IO_PORT "leds[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC "leds[1]" 16;
IO_PORT "leds[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC "leds[2]" 17;
IO_PORT "leds[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC "leds[3]" 18;
IO_PORT "leds[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC "leds[4]" 19;
IO_PORT "leds[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

IO_LOC "leds[5]" 20;
IO_PORT "leds[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8;

// The 55 SDRAM signals are deliberately absent: Gowin bonds O_sdram_* and
// IO_sdram_dq to the in-package die automatically, on internal pads outside the
// 66-pin package budget. See docs/sdram.md.
