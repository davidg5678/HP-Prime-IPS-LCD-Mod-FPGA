<?xml version="1" encoding="UTF-8"?>
<!DOCTYPE gowin-fpga-project>
<Project>
    <Template>FPGA</Template>
    <Version>5</Version>
    <Device name="GW2AR-18C" pn="GW2AR-LV18QN88C8/I7">gw2a18c-001</Device>
    <!-- GUI-only / best-effort. The headless build (tools/build/gowin_build.sh)
         generates its own self-contained .tcl from src/targets/<target>/files.txt
         and never reads this file, so keep this list in sync by hand or not at
         all. Contents mirror src/targets/bringup_selftest/files.txt. -->
    <FileList>
        <File path="src/common/lfsr8.v" type="file.verilog" enable="1"/>
        <File path="src/common/uart_tx.v" type="file.verilog" enable="1"/>
        <File path="src/common/uart_rx.v" type="file.verilog" enable="1"/>
        <File path="src/targets/bringup_selftest/bringup_selftest_top.v" type="file.verilog" enable="1"/>
        <File path="src/targets/bringup_selftest/bringup_selftest.cst" type="file.cst" enable="1"/>
        <File path="src/targets/bringup_selftest/bringup_selftest.sdc" type="file.sdc" enable="1"/>
    </FileList>
</Project>
